# Dependencies
node_modules/

# Environment / secret files
.env
.env.local
.env.*.local

# Database files (local runtime SQLite databases)
data/*.db
data/*.db-shm
data/*.db-wal
!data/.gitkeep

# Uploaded content files (ignore uploaded media, keep directory structure)
uploads/*
!uploads/.gitkeep
!uploads/*/.gitkeep

# Logs and runtime files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pm2/
*.pm2.log

# Operating system / IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
