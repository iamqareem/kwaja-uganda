# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the server listens on
PORT=3000

# Long random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The one admin account (the site owner). No user table — just these two values.
# ADMIN_USERNAME can be an email address — it is just a string match.
ADMIN_USERNAME=support@kwajaug.org

# A bcrypt hash of the admin password — never the plain password itself.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-real-password', 10))"
ADMIN_PASSWORD_HASH=

# Donations for Kwaja Uganda go through the official GoFundMe campaign
# (see GOFUNDME_URL in server.js). No payment keys live in this file.
