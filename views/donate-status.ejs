<%- include('partials/header') %>

<section class="donate-status-section" style="padding: 80px 0;">
  <div class="wrap center donate-status-wrap" style="max-width: 600px; margin: 0 auto; background: var(--bg-card); padding: 48px 32px; border-radius: 16px; border: 1px solid var(--border-color);">
    <% if (state === 'not_configured') { %>
      <p class="eyebrow center">Kwaja Uganda</p>
      <h1>Online Donations Coming Soon</h1>
      <p>We are finishing setup with our payment provider. Please contact us directly or visit our Instagram to support Kwaja Uganda today.</p>
      <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: center;">
        <a href="https://www.instagram.com/kwajaug/" target="_blank" class="btn btn-gold">Visit @kwajaug on Instagram</a>
        <a href="mailto:info@kwajauganda.org" class="btn btn-outline">Email Us</a>
      </div>

    <% } else if (state === 'completed') { %>
      <p class="eyebrow center">Thank You So Much</p>
      <h1>Your Generous Gift Was Received</h1>
      <p>Open your heart; your gentle kindness creates beautiful hope! Thank you for supporting Kwaja Uganda<% if (amount) { %> &mdash; your donation of UGX <%= Number(amount).toLocaleString() %> directly provides food, safety, and care for our children.<% } else { %>.<% } %></p>
      <a href="/" class="btn btn-gold" style="margin-top: 24px;">Back to Homepage</a>

    <% } else if (state === 'pending') { %>
      <p class="eyebrow center">Kwaja Uganda</p>
      <h1>Payment Pending Confirmation</h1>
      <p>We are awaiting confirmation from the payment gateway. If you approved a mobile money prompt, this usually completes within 1-2 minutes.</p>
      <a href="/" class="btn btn-outline" style="margin-top: 24px;">Return Home</a>

    <% } else if (state === 'failed') { %>
      <p class="eyebrow center">Payment Issue</p>
      <h1>Payment Was Not Completed</h1>
      <p>Your donation attempt did not go through and no funds were deducted. Please feel free to try again.</p>
      <a href="/#donate" class="btn btn-gold" style="margin-top: 24px;">Try Again</a>

    <% } else if (state === 'invalid_amount') { %>
      <p class="eyebrow center">Kwaja Uganda</p>
      <h1>Please Enter a Valid Amount</h1>
      <p>Select a preset donation amount or enter a custom amount to continue.</p>
      <a href="/#donate" class="btn btn-gold" style="margin-top: 24px;">Back to Donate Form</a>

    <% } else { %>
      <p class="eyebrow center">Kwaja Uganda</p>
      <h1>Something Went Wrong</h1>
      <p>We could not complete the transaction at this moment. Please try again or reach out to us directly.</p>
      <a href="/#donate" class="btn btn-outline" style="margin-top: 24px;">Try Again</a>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
