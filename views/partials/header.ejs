<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Kwaja Uganda | Love Heals Broken Worlds' %></title>
<% if (typeof pageDescription !== 'undefined' && pageDescription) { %>
<meta name="description" content="<%= pageDescription %>">
<% } else { %>
<meta name="description" content="Love heals broken worlds. We nurture forgotten souls with safety. Kwaja Uganda Orphanage, directed by Tenywa Fatiik.">
